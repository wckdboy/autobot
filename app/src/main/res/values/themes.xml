<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window-level theme only; all UI is drawn by Compose (AutobotTheme). Dark-first. -->
    <style name="Theme.Autobot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/graphite_950</item>
        <item name="android:colorBackground">@color/graphite_950</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Launch screen: the purple a on ink (no icon plate). -->
        <item name="android:windowSplashScreenBackground">@color/graphite_950</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/graphite_950</item>
    </style>

    <!-- The same on paper: chosen for the next launch when the app is set to light (MainActivity). -->
    <style name="Theme.Autobot.Paper">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/paper</item>
    </style>

    <!-- Home screen launcher widget (RemoteViews). -->
    <style name="Widget.Autobot.LauncherButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textColor">#FFF4EEE6</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
</resources>
