<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window-level theme only; all UI is drawn by Compose (AutobotTheme). Dark-first. -->
    <style name="Theme.Autobot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/graphite_950</item>
        <item name="android:colorBackground">@color/graphite_950</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
